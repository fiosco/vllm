# Fiosco vLLM v0.2.0 overlay image.
#
# Base: official upstream `vllm/vllm-openai:v0.26.0` (pick the arch matching the
# target: amd64 for SM120 RTX Blackwell, arm64 for sm_121 DGX Spark GB10).
# Adds: the NCCL 2.29.7 pin + the Arm-A Python carries (release/cu130-v0.2.0) +
# the DeepGEMM sm121 MQA-logits kernel aliases (Track B, sm_121 only).
#
# Build (from the repo root as context):
#   docker build -f docker/Dockerfile.fiosco-overlay \
#     --build-arg BASE=vllm/vllm-openai:v0.26.0 -t fiosco/vllm:v0.2.0 .
#
# The full multi-arch build + distribution is owned by the separate
# fiosco-vllm-blackwell-docker plan; this overlay is the minimal production image.

ARG BASE=vllm/vllm-openai:v0.26.0
FROM ${BASE}

ARG SITE=/usr/local/lib/python3.12/dist-packages/vllm

# --- NCCL: replace the 2.28.9 pip wheel ---------------------------------------
# torch 2.11.0+cu130 depends on nvidia-nccl-cu13==2.28.9, so the base image ships
# the 2.28.9 wheel at NCCL_LIB. That is the file torch's _load_global_deps() opens
# by absolute path, i.e. the build that serves every collective. Its aarch64 build
# hangs indefinitely in ncclAllGather during the TP4 logits gather on the GB10
# cluster: an ARM compare-and-swap weak failure that only reaches builds compiled
# with gcc older than 10, which the wheel is and the apt build of the same version
# is not. Fixed in 2.29.3 source, so any 2.29.3+ build is safe whatever the
# compiler. Overwriting the wheel is what makes this shippable — LD_PRELOAD only
# wins a symbol-resolution race and leaves both builds mapped.
# --no-deps keeps torch out of the transaction, since its dependency is an == pin.
ARG NCCL_VERSION=2.29.7
ARG NCCL_LIB=/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib/libnccl.so.2
# Identity of the aarch64 wheel validated on all four DGX Spark nodes. Only checked
# on aarch64 — the amd64 wheel is a different file and this image builds for both.
ARG NCCL_AARCH64_BYTES=237975080
ARG NCCL_AARCH64_SHA256=cc01f863461ea28f3ecc4390716a2d7a5aca9bc00e04eeb6fc7a5c2e666b3dfb
RUN set -eux; \
    pip install --no-cache-dir --no-deps --force-reinstall "nvidia-nccl-cu13==${NCCL_VERSION}"; \
    pip show nvidia-nccl-cu13 | grep -qx "Version: ${NCCL_VERSION}"; \
    if [ "$(uname -m)" = aarch64 ]; then \
      test "$(stat -c %s "${NCCL_LIB}")" = "${NCCL_AARCH64_BYTES}"; \
      echo "${NCCL_AARCH64_SHA256}  ${NCCL_LIB}" | sha256sum -c -; \
    fi
# The apt build at /usr/lib/aarch64-linux-gnu/libnccl.so.2.28.9 is left alone:
# removing libnccl2 would also drop libnccl-dev, and that build is never mapped
# without an explicit preload.

# --- Arm-A carries: Python deltas overlaid from release/cu130-v0.2.0 -----------
# pr-37132 spec-decode prepare_inputs_event re-record (MTP race)
COPY vllm/v1/worker/gpu_model_runner.py                              ${SITE}/v1/worker/gpu_model_runner.py
# pr-37564 NVFP4/MXFP4 expert padding-scale zero-init
COPY vllm/_custom_ops.py                                            ${SITE}/_custom_ops.py
# pr-37700 FLA Hopper/TMA SM12x misclassification (SMEM-gated)
COPY vllm/third_party/flash_linear_attention/ops/chunk_o.py         ${SITE}/third_party/flash_linear_attention/ops/chunk_o.py
COPY vllm/third_party/flash_linear_attention/ops/utils.py           ${SITE}/third_party/flash_linear_attention/ops/utils.py
# pr-41994 Qwen3.5 MTP compressed-tensors ignore
COPY vllm/model_executor/models/qwen3_5_mtp.py                      ${SITE}/model_executor/models/qwen3_5_mtp.py
# fiosco modelopt-mixed-pbwo FP8_PB_WO dispatch
COPY vllm/model_executor/layers/quantization/modelopt.py           ${SITE}/model_executor/layers/quantization/modelopt.py
# pr-47779 FlashInferMLASparseSM120 returns LSE from decode (required for DCP)
COPY vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py  ${SITE}/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py
# fiosco DCP cudagraph-profiling guard (single-block throwaway KV pool)
COPY vllm/v1/worker/cp_utils.py                                     ${SITE}/v1/worker/cp_utils.py

# --- Track B: DeepGEMM sm121 MQA-logits kernel aliases (option a) --------------
# The bundled DeepGEMM ships FP8/FP4 MQA-logits ("lightning indexer") kernels for
# sm90/100/120 but NOT sm121, and couples both the include filename and the entry
# symbol to the arch string with no sm120 fallback. sm120 SASS is forward-
# compatible on sm121 (the kernel guard is __CUDA_ARCH__ >= 1200, which admits
# 1210), so alias each sm120 kernel to the sm121 filename + entry symbol. Harmless
# on non-sm121 arches (the aliases are only JIT-selected on cap-12.1 devices).
# Long-term this is upstreamable to DeepGEMM (a >=1200 dispatch); see plan B0.
RUN set -eux; \
    D=${SITE}/third_party/deep_gemm/include/deep_gemm/impls; \
    if [ -d "$D" ]; then \
      for v in fp8_mqa_logits fp8_paged_mqa_logits fp4_mqa_logits fp4_paged_mqa_logits; do \
        if [ -f "$D/sm120_$v.cuh" ]; then \
          cp "$D/sm120_$v.cuh" "$D/sm121_$v.cuh"; \
          sed -i 's/sm120_fp/sm121_fp/g' "$D/sm121_$v.cuh"; \
        fi; \
      done; \
      echo "DeepGEMM sm121 aliases created:"; ls "$D"/sm121_*.cuh; \
    else \
      echo "WARN: DeepGEMM impls dir not found at $D (base image layout changed?)"; \
    fi

# --- Import sanity + last-layer NCCL re-assert ---------------------------------
# The NCCL identity is re-checked here, in the FINAL layer, so that no later layer
# can quietly shadow or downgrade the library and an unreplaced wheel fails the
# build instead of reaching the cluster. 2.29.7 -> ncclGetVersion 22907.
RUN python3 -c "import ctypes, inspect; \
import vllm, vllm._custom_ops; \
import vllm.model_executor.layers.quantization.modelopt as m; \
import vllm.model_executor.models.qwen3_5_mtp; \
import vllm.third_party.flash_linear_attention.ops.utils; \
from vllm.v1.attention.backends.mla import flashinfer_mla_sparse_sm120 as s; \
import vllm.v1.worker.cp_utils as c; \
assert hasattr(m, 'ModelOptFp8PbWoLinearMethod'); \
assert s.FlashInferMLASparseSM120Impl.can_return_lse_for_decode is True; \
assert 'max_valid_block_id <= 0' in inspect.getsource(c.prepare_dcp_dummy_context_metadata); \
v = ctypes.c_int(); \
ctypes.CDLL('${NCCL_LIB}').ncclGetVersion(ctypes.byref(v)); \
assert v.value == 22907, v.value; \
print('fiosco/vllm:v0.2.0 overlay import OK, nccl', v.value)"
